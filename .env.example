# Base URL a real backend would be reached at. Unused today — every feature's
# api/index.ts currently re-exports its mock.ts implementation, which never
# reads this value. Once a feature is wired to a real backend (its
# api/index.ts calling `@/lib/http`'s `request()` instead of `./mock`), this
# becomes that request's prefix.
VITE_API_BASE_URL=

# Set to "false" to signal a feature's api layer to use its real
# implementation instead of mocks, once one exists. Defaults to true.
VITE_USE_MOCKS=true
