# Base URL a real backend would be reached at. Unused today — every feature's
# api/index.ts currently re-exports its mock.ts implementation, which never
# reads this value. Once a feature is wired to a real backend (its
# api/index.ts calling `@/lib/http`'s `request()` instead of `./mock`), this
# becomes that request's prefix.
VITE_API_BASE_URL=

# Set to "false" to signal a feature's api layer to use its real
# implementation instead of mocks, once one exists. Defaults to true.
VITE_USE_MOCKS=true

# Google reCAPTCHA v2 ("I'm not a robot") site key, shown on the login and
# registration forms. Public by design — get one at
# https://www.google.com/recaptcha/admin. The matching secret key belongs
# on the backend only, for verifying tokens server-side; never put it here.
VITE_RECAPTCHA_SITE_KEY=

# Cloudinary — direct browser-to-Cloudinary uploads for the registration
# form's photos and video pitch (see lib/cloudinary.ts), so those files
# never pass through our own server/bandwidth at all.
#
# Setup, in the Cloudinary dashboard (Settings → Upload → Upload presets):
#   1. VITE_CLOUDINARY_CLOUD_NAME — your account's cloud name, shown on the
#      dashboard home page. Public by design, same as the reCAPTCHA key.
#   2. VITE_CLOUDINARY_UPLOAD_PRESET — add a new upload preset, set its
#      "Signing Mode" to Unsigned. Strongly recommend also setting, on that
#      preset: an explicit Folder (e.g. "mbopo-applications") so uploads
#      land somewhere predictable, and Allowed formats / a max file size
#      matching what the app accepts (jpg, png, pdf for documents; webm,
#      mp4 for the video pitch — capped at 30MB there).
#
# This is the *unsigned* preset pattern — fine for getting this working
# now, but an unsigned preset can be used by anyone who finds its name, not
# just this app. Once the backend is ready, consider switching to signed
# uploads instead: the backend computes a signature (using the account's
# API secret, which must never appear in frontend code) and hands it to
# the browser per-upload. lib/cloudinary.ts is written so that swap only
# touches that one file.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=