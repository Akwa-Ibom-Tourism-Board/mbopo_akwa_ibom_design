# Backend base URL, including its /api/v1 mount point (see the backend's
# src/app.ts) — e.g. http://localhost:4000/api/v1 in development.
VITE_API_BASE_URL=

# Google reCAPTCHA v2 ("I'm not a robot") site key, shown on the login and
# registration forms. Public by design — get one at
# https://www.google.com/recaptcha/admin. The matching secret key belongs
# on the backend only, for verifying tokens server-side; never put it here.
VITE_RECAPTCHA_SITE_KEY=
